{
  "name": "@main-ui/view-world",
  "version": "0.6.0",
  "private": false,
  "description": "main-ui 官方视图模板：2D 世界可视化（L1 中级游戏引擎层）。消费通用 EntitySnapshot 自动渲染图元（Grid/Sprite/Text/Polygon），支持手动模式（onReady 逃生舱）与 InteractionLayer（点击/拖拽 + screen→world 命中）。内核用 @main-ui/core/rendering（PixiJS WebGL）。取代已废弃的 view-2d。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/view-world"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@main-ui/core": "^0.5.0",
    "main-ui": "^0.6.0",
    "pixi.js": "^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@main-ui/core": "workspace:*",
    "main-ui": "workspace:*",
    "pixi.js": "^8.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
}
