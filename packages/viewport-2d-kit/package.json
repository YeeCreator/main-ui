{
  "name": "@main-ui/viewport-2d-kit",
  "version": "0.1.0",
  "private": true,
  "description": "框架无关的 2D 视口能力层（PixiJS 内核）：相机、缩放、平移、坐标换算与视口导航。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/viewport-2d-kit"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./main-ui": {
      "types": "./dist/main-ui/index.d.ts",
      "import": "./dist/main-ui/index.js"
    },
    "./react-legacy": {
      "types": "./dist/react-legacy/index.d.ts",
      "import": "./dist/react-legacy/index.js"
    },
    "./pixi": {
      "types": "./dist/pixi/index.d.ts",
      "import": "./dist/pixi/index.js"
    },
    "./react-pixi": {
      "types": "./dist/react-pixi/index.d.ts",
      "import": "./dist/react-pixi/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "vue": "^3.5.0",
    "tsup": "^8.0.2",
    "typescript": "~5.7.2"
  }
}
