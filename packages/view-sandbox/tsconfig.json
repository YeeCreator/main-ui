{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "main-ui": ["../main-ui/src/index.ts"],
      "main-ui/core": ["../main-ui/src/core/index.ts"],
      "main-ui/vue": ["../main-ui/src/vue/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
