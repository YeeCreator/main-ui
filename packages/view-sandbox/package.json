{
  "name": "@main-ui/view-sandbox",
  "version": "0.6.0",
  "private": false,
  "description": "main-ui 官方旗舰复合视图模板：自由沙盘画布（2D 视口 + 异构元素 + 嵌入任意 Preset-View + 连线），嵌套深度保护默认 8 层。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/view-sandbox"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@main-ui/core": "^0.5.0",
    "main-ui": "^0.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@main-ui/core": "workspace:*",
    "main-ui": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
}
