{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@main-ui/core": ["../core/src/index.ts"],
      "@main-ui/core/rendering": ["../core/src/rendering/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
