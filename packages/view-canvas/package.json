{
  "name": "@main-ui/view-canvas",
  "version": "0.8.0",
  "private": false,
  "description": "main-ui 官方视图模板：DOM/SVG 2D 画布视口（相机 + 指针/滚轮交互 + 默认插槽暴露 cameraTransform）。用于「宿主自绘 DOM/SVG 内容」的场景，与 PixiJS 渲染的 @main-ui/view-world 互补；相机数学基于 @main-ui/core/rendering。取代已废弃的 viewport-2d-kit/vue。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/view-canvas"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@main-ui/core": "^0.8.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@main-ui/core": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
}
