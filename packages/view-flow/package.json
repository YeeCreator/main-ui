{
  "name": "@main-ui/view-flow",
  "version": "0.5.0",
  "private": false,
  "description": "main-ui 官方视图模板：流程/状态机文档编辑器（类型化端口 + 数据流/控制流双边 + FSM 语义），三件套交付：L2 内核 + L1 FlowCanvas 组件 + L3 FlowView 薄壳。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/view-flow"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@main-ui/core": "^0.5.0",
    "@vue-flow/core": "^1.48.0",
    "main-ui": "^0.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@main-ui/core": "workspace:*",
    "@vue-flow/core": "^1.48.0",
    "main-ui": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
}
