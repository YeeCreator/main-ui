{
  "name": "@main-ui/view-run-control",
  "version": "0.1.0",
  "private": false,
  "description": "main-ui 官方控制视图模板：运行/暂停/单步/重置/速率控制的通用 UI 原语。数据经 Props 注入，操作以意图经 Emits 抛出；语义为通用仿真/控制（status/rate/tick），不绑定任何领域。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/view-run-control"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "main-ui": "^0.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "main-ui": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
}
