{
  "name": "@main-ui/preset-views",
  "version": "1.0.0-alpha",
  "private": false,
  "description": "main-ui 官方视图模板聚合包：一次性引入数据模板（tree / inspector / table / form / node / console）、画布模板（world / sandbox / flow / host-engine），仅重导出。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git",
    "directory": "packages/preset-views"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@main-ui/core": "^1.0.0-alpha",
    "@main-ui/view-world": "^1.0.0-alpha",
    "@main-ui/view-console": "^1.0.0-alpha",
    "@main-ui/view-flow": "^1.0.0-alpha",
    "@main-ui/view-host-engine": "^1.0.0-alpha",
    "@main-ui/view-form": "^1.0.0-alpha",
    "@main-ui/view-inspector": "^1.0.0-alpha",
    "@main-ui/view-node": "^1.0.0-alpha",
    "@main-ui/view-sandbox": "^1.0.0-alpha",
    "@main-ui/view-table": "^1.0.0-alpha",
    "@main-ui/view-tree": "^1.0.0-alpha",
    "@vue-flow/core": "^1.48.0",
    "main-ui": "^1.0.0-alpha",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@main-ui/core": "workspace:^1.0.0-alpha",
    "@main-ui/view-world": "workspace:^1.0.0-alpha",
    "@main-ui/view-console": "workspace:^1.0.0-alpha",
    "@main-ui/view-flow": "workspace:^1.0.0-alpha",
    "@main-ui/view-host-engine": "workspace:^1.0.0-alpha",
    "@main-ui/view-form": "workspace:^1.0.0-alpha",
    "@main-ui/view-inspector": "workspace:^1.0.0-alpha",
    "@main-ui/view-node": "workspace:^1.0.0-alpha",
    "@main-ui/view-sandbox": "workspace:^1.0.0-alpha",
    "@main-ui/view-table": "workspace:^1.0.0-alpha",
    "@main-ui/view-tree": "workspace:^1.0.0-alpha",
    "@vue-flow/core": "^1.48.2",
    "main-ui": "workspace:^1.0.0-alpha",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  }
