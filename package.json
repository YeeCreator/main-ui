{
  "name": "main-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YeeCreator/main-ui.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter main-ui dev",
    "build": "pnpm --filter main-ui build && pnpm --filter \"@main-ui/viewport-2d-kit\" build && pnpm --filter \"@main-ui/view-*\" build && pnpm --filter \"@main-ui/preset-views\" build",
    "typecheck": "pnpm --filter main-ui --filter \"@main-ui/viewport-2d-kit\" --filter \"@main-ui/view-*\" --filter \"@main-ui/preset-views\" typecheck",
    "test": "pnpm --filter main-ui --filter \"@main-ui/view-*\" test",
    "demo:dev": "pnpm --filter main-ui-demo dev",
    "demo:build": "pnpm --filter main-ui-demo build",
    "test:e2e": "playwright test",
    "analyze:dist": "node scripts/report-dist-size.mjs packages/main-ui/dist",
    "release:pack": "pnpm build && node scripts/copy-release-docs.mjs && pnpm --filter main-ui pack --pack-destination ../../"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~5.7.2",
    "vite": "^7.1.5",
    "vue": "^3.5.0"
  }
}
